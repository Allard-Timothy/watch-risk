# Reserved for later integration steps.
# No external services are required by the initial scaffold.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma datasource. The database is not wired yet: this is only used by
# `prisma` CLI commands (validate/generate/migrate) once you connect a database.
# The docker-compose Postgres at the repo root is a convenient local target.
DATABASE_URL=postgresql://watchrisk:watchrisk@localhost:5432/watchrisk?schema=public

# Reserved for later integration steps.
# No external services are required by the initial scaffold.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma datasource. Matches docker-compose.yml (Postgres user/db `watchrisk`).
# Required to save and reload cases. Overview and the sample report still render
# without a database.
DATABASE_URL=postgresql://watchrisk:watchrisk@localhost:5432/watchrisk?schema=public

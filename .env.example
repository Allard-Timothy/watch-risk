# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres via docker compose)
DATABASE_URL=postgresql://watchrisk:watchrisk@localhost:5432/watchrisk?schema=public

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=development-secret-change-me

# Email magic links log to the server console in development
EMAIL_PROVIDER=console
EMAIL_FROM=WatchTell <no-reply@localhost>
EMAIL_SERVER=smtp://dev:dev@localhost:1025?secure=false

# Payments: mock (default) or stripe when STRIPE_SECRET_KEY is set
PAYMENTS_MODE=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional future integrations (not required locally)
# OPENAI_API_KEY=
# GCS_BUCKET=

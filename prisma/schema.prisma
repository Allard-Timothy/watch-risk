// WatchTell data model.
//
// This schema mirrors the entities described in docs/reference/architecture-typescript.md
// and docs/explanation/knowledge-architecture.md. Auth, storage, payments, and model
// calls use provider seams (mock/local by default). WatchCase listing details and
// CaseImage metadata are persisted; photo bytes live under .data/uploads until GCS is
// wired. Seller/community/evidence tables hold curated local knowledge (seed JSON),
// not scraped forum dumps. TD status is stored as community recognition, not a
// universal trust boolean.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAID
  ANALYZING
  COMPLETE
  ERROR
}

enum PhotoType {
  DIAL
  REHAUT
  DATE_CYCLOPS
  BEZEL
  CROWN_GUARDS
  CASEBACK
  BRACELET
  CLASP
  END_LINKS
  MOVEMENT
  PAPERS
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CANNOT_ASSESS
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum AnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIAL
}

enum SellerLifecycleStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum CommunityRecognitionStatus {
  FULL_TD
  PROVISIONARY_TD
  TRUSTED_SELLER
  ESTABLISHED_SELLER
  RECOMMENDED_SELLER
  LISTED_SELLER
  FORMER_TD
  REMOVED_TD
  BANNED
  UNKNOWN
}

enum QualitativeLabel {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_EVIDENCE
}

enum RiskCategory {
  FRAUD
  OPERATIONAL
  QC
  AFTER_SALES
  PRODUCT_CLAIM
}

enum EvidenceKind {
  TD_LISTING
  MODERATOR_REVIEW
  MODERATOR_TEST_PURCHASE
  BUYER_REVIEW
  TRANSACTION_REPORT
  GIVEAWAY_OR_SPONSORSHIP
  SELLER_PROMOTION
  FORUM_STATUS
  INDEPENDENT_REVIEW
  WATCHTELL_OUTCOME
  OTHER
}

enum SourceKind {
  FORUM
  REDDIT
  WEBSITE
  MANUAL_CURATION
  WATCHTELL_USER
  OTHER
}

enum ClaimSentiment {
  POSITIVE
  NEGATIVE
  MIXED
  NEUTRAL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  cases         WatchCase[]
  credits       ReportCredit?
  subscription  Subscription?
  payments      PaymentRecord[]
  outcomes      Outcome[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReportCredit {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  monthlyCredits       Int                @default(3)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model WatchCase {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  brand          String
  model          String?
  reference      String?
  claimedYear    String?
  askingPrice    Decimal?
  sellerPlatform String?
  listingUrl     String?
  listingText    String?
  sellerClaims   String?
  status         CaseStatus      @default(DRAFT)
  images         CaseImage[]
  analysisRuns   AnalysisRun[]
  reports        Report[]
  payments       PaymentRecord[]
  outcomes       Outcome[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([sellerId])
}

model CaseImage {
  id           String     @id @default(cuid())
  caseId       String
  case         WatchCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  storagePath  String
  claimedType  PhotoType?
  detectedType String?
  qualityScore Float?
  usable       Boolean    @default(true)
  analysisJson Json?
  createdAt    DateTime   @default(now())

  @@index([caseId])
}

model AnalysisRun {
  id             String            @id @default(cuid())
  caseId         String
  case           WatchCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status         AnalysisRunStatus @default(PENDING)
  modelUsed      String?
  promptVersion  String?
  rawModelOutput Json?
  error          String?
  report         Report?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([caseId])
}

model Report {
  id             String          @id @default(cuid())
  caseId         String
  case           WatchCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  analysisRunId  String?         @unique
  analysisRun    AnalysisRun?    @relation(fields: [analysisRunId], references: [id])
  riskLevel      RiskLevel
  confidence     ConfidenceLevel
  reportJson     Json
  reportText     String
  rawModelOutput Json?
  modelUsed      String
  promptVersion  String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([caseId])
}

model PaymentRecord {
  id                      String        @id @default(cuid())
  userId                  String?
  user                    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseId                  String?
  case                    WatchCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  sku                     String?
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  amountCents             Int           @default(0)
  currency                String        @default("usd")
  status                  PaymentStatus @default(CREATED)
  rawEvent                Json?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([caseId])
  @@index([userId])
}

model Outcome {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId           String
  case             WatchCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  receivedWatch    Boolean?
  qcPhotosMatched  Boolean?
  fulfillmentIssue String?
  factoryClaimNote String?
  consentToStore   Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([caseId])
}

model Community {
  id                String            @id
  displayName       String
  independenceGroup String
  formalTdProgram   Boolean           @default(false)
  notes             String?
  vettingNotes      String?
  sellerCommunities SellerCommunity[]
  evidence          Evidence[]
  sources           Source[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Seller {
  id              String                @id
  canonicalName   String
  status          SellerLifecycleStatus @default(ACTIVE)
  likes           String[]
  concerns        String[]
  interpretation  String?
  aliases         SellerAlias[]
  communities     SellerCommunity[]
  trustDimensions TrustDimension[]
  riskFlags       RiskFlag[]
  evidence        Evidence[]
  claims          Claim[]
  cases           WatchCase[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model SellerAlias {
  id                 String   @id @default(cuid())
  sellerId           String
  seller             Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  alias              String
  identityConfidence Float
  evidenceNote       String?
  createdAt          DateTime @default(now())

  @@unique([sellerId, alias])
  @@index([alias])
}

model SellerCommunity {
  id                                String                      @id @default(cuid())
  sellerId                          String
  seller                            Seller                      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  communityId                       String
  community                         Community                   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  status                            CommunityRecognitionStatus
  statusSince                       DateTime?
  moderatorVetted                   Boolean                     @default(false)
  formalTdProgram                   Boolean                     @default(false)
  sellerParticipationRequired       Boolean                     @default(false)
  giveawayOrSponsorshipRelationship Boolean                     @default(false)
  notes                             String?

  @@unique([sellerId, communityId])
}

model TrustDimension {
  id       String           @id @default(cuid())
  sellerId String
  seller   Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  key      String
  label    QualitativeLabel
  notes    String?

  @@unique([sellerId, key])
}

model RiskFlag {
  id       String           @id @default(cuid())
  sellerId String
  seller   Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category RiskCategory
  label    QualitativeLabel
  summary  String
}

model Source {
  id                String     @id
  kind              SourceKind
  communityId       String?
  community         Community? @relation(fields: [communityId], references: [id])
  title             String
  url               String?
  publishedAt       DateTime?
  retrievedAt       DateTime?
  independenceGroup String
  evidence          Evidence[]
  claims            Claim[]
}

model Evidence {
  id                String          @id @default(cuid())
  sellerId          String
  seller            Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  communityId       String?
  community         Community?      @relation(fields: [communityId], references: [id])
  sourceId          String?
  source            Source?         @relation(fields: [sourceId], references: [id])
  evidenceType      EvidenceKind
  independenceGroup String
  claimText         String
  sentiment         ClaimSentiment?
  confidence        Float?
  publishedAt       DateTime?
  retrievedAt       DateTime?
  sourceUrl         String?

  @@index([sellerId])
  @@index([independenceGroup])
}

model Claim {
  id          String    @id @default(cuid())
  sellerId    String?
  seller      Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sourceId    String?
  source      Source?   @relation(fields: [sourceId], references: [id])
  subjectType String
  subjectId   String
  predicate   String
  value       String
  confidence  Float?
  observedAt  DateTime?

  @@index([subjectType, subjectId])
}

model Factory {
  id              String           @id
  canonicalName   String
  notes           String?
  versions        FactoryVersion[]
  knownVariances  KnownVariance[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model FactoryVersion {
  id             String          @id
  factoryId      String
  factory        Factory         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  label          String
  notes          String?
  knownVariances KnownVariance[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([factoryId])
}

model KnownVariance {
  id                      String          @id
  factoryId               String
  factory                 Factory         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  factoryVersionId        String?
  factoryVersion          FactoryVersion? @relation(fields: [factoryVersionId], references: [id], onDelete: SetNull)
  area                    String
  photoType               String?
  whatBuyersShouldLookFor   String
  whatPhotosCannotShow      String
  references              String[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([factoryId])
  @@index([factoryVersionId])
}
